<div style="font-family: Arial, sans-serif; max-width: 700px; margin: auto; border: 1px solid #ccc; border-radius: 10px; padding: 20px;">
  <h2 style="text-align: center;">Quotation</h2>

  <table width="100%" style="margin-bottom: 20px;">
    <tr>
      <td><strong>Inquiry:</strong> #{{inquiryId}}</td>
      <td><strong>VRM:</strong> {{vrm}}</td>
    </tr>
    <tr>
      <td><strong>Company:</strong> {{companyName}}</td>
      <td><strong>Engine Size:</strong> {{engineSize}}</td>
    </tr>
    <tr>
      <td><strong>Email:</strong> {{email}}</td>
      <td><strong>Vehicle Model:</strong> {{vehicleModel}}</td>
    </tr>
    <tr>
      <td><strong>Contact:</strong> {{contact}}</td>
      <td><strong>Engine Code:</strong> {{engineCode}}</td>
    </tr>
  </table>

  <table width="100%" border="1" cellspacing="0" cellpadding="8" style="border-collapse: collapse; text-align: center;">
    <thead style="background-color: #f9f9f9;">
      <tr>
        <th>Item Description</th>
        <th>Rate</th>
        <th>Qty</th>
        <th>Discount</th>
        <th>Tax</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td>{{itemDescription}}</td>
        <td>${{rate}}</td>
        <td>{{quantity}}</td>
        <td>{{discountPercent}}%</td>
        <td>{{taxPercent}}%</td>
        <td>${{totalAmount}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <h3 style="text-align: right; margin-top: 10px;">Grand Total: ${{grandTotal}}</h3>

  <hr>

  <h4>Seller Note:</h4>
  <p>{{sellerNote}}</p>

  <h4>Quotation Terms:</h4>
  <p>{{quotationTerms}}</p>

  <h4>Sales Terms:</h4>
  <p>{{salesTerms}}</p>
</div>
