<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Invoice {{invoiceData.invoiceNumber}}</title>
  <style>
    body {
      font-family: 'Arial', sans-serif;
      background-color: #fff;
      margin: 0;
      padding: 0;
    }

    .invoice-container {
      width: 800px;
      margin: 30px auto;
      border: 2px solid #000;
      border-radius: 12px;
      padding: 25px 40px;
    }

    h1 {
      text-align: center;
      margin: 0;
      font-size: 22px;
      font-weight: 700;
    }

    .header-info {
      display: flex;
      justify-content: space-between;
      margin-top: 10px;
      border-bottom: 2px solid #000;
      padding-bottom: 8px;
      font-size: 14px;
    }

    .header-info div {
      width: 48%;
    }

    .header-info strong {
      display: inline-block;
      width: 120px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      font-size: 14px;
    }

    th, td {
      border: 1px solid #000;
      padding: 8px;
      text-align: center;
    }

    th {
      background-color: #f3f3f3;
    }

    .total-row td {
      font-weight: bold;
      text-align: right;
    }

    .section {
      margin-top: 25px;
      border: 2px solid #000;
      border-radius: 10px;
      padding: 15px;
    }

    .section h3 {
      margin-top: 0;
      margin-bottom: 8px;
      font-size: 15px;
      font-weight: 700;
    }

    .bank-seller {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      margin-top: 25px;
    }

    .bank-seller .section {
      flex: 1;
      height: auto;
    }

    .terms-section {
      margin-top: 20px;
      font-size: 13px;
    }

    .terms-section h4 {
      margin-bottom: 5px;
      font-weight: bold;
    }

    .grand-total {
      text-align: right;
      margin-top: 10px;
      font-size: 15px;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <div class="invoice-container">
    <h1>Invoice</h1>

    <div class="header-info">
      <div>
        <p><strong>Invoice No:</strong> {{invoiceData.invoiceNumber}}</p>
        <p><strong>Company Name:</strong> {{invoiceData.dealer.name}}</p>
        <p><strong>Phone:</strong></p>
      </div>
      <div>
        <p><strong>Email:</strong> {{invoiceData.dealer.email}}</p>
        <p><strong>Invoice Date:</strong> {{invoiceData.date}}</p>
      </div>
    </div>

    <table>
      <thead>
        <tr>
       
          <th>Rate</th>
          <th>Qty</th>
          <th>Discount</th>
          <th>Tax</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        {{#each invoiceData.items}}
        <tr>
      
          <td>${{this.unitPrice}}</td>
          <td>{{this.quantity}}</td>
          <td>{{this.discount}}</td>
          <td>{{this.taxAmount}}</td>
          <td>${{this.subTotal}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="grand-total">
      Grand Total: ${{invoiceData.grandTotal}}
    </div>

    <div class="bank-seller">
      {{#if invoiceData.bank}}
      <div class="section">
        <h3>Bank Details</h3>
        <p><strong>Account Holder:</strong> {{invoiceData.bank.accountHolderName}}</p>
        <p><strong>Account Number:</strong> {{invoiceData.bank.accountNumber}}</p>
        <p><strong>Bank Name:</strong> {{invoiceData.bank.bankName}}</p>
        <p><strong>Branch Name:</strong> {{invoiceData.bank.branchName}}</p>
        <p><strong>IFSC:</strong> {{invoiceData.bank.ifscCode}}</p>
        <p><strong>IBAN:</strong> {{invoiceData.bank.iban}}</p>
        <p><strong>SWIFT:</strong> {{invoiceData.bank.swiftCode}}</p>
      </div>
      {{/if}}

      <div class="section">
        <h3>Seller Note</h3>
        <p>{{invoiceData.sellerNote}}</p>
      </div>
    </div>

    <div class="terms-section">
      <h4>Quotation Terms:</h4>
      <p>{{invoiceData.quotationTerms}}</p>
    </div>

    <div class="terms-section">
      <h4>Sales Terms:</h4>
      <p>{{invoiceData.salesTerms}}</p>
    </div>
  </div>
</body>
</html>
