<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Invoice {{invoiceData.invoiceNumber}}</title>
  <style>
    body {
      font-family: 'Arial', sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f5f6fa;
    }
    .container {
      max-width: 800px;
      margin: 40px auto;
      background-color: #ffffff;
      padding: 30px;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    h1 {
      text-align: center;
      color: #2f3640;
      margin-bottom: 5px;
    }
    .invoice-header, .invoice-footer {
      width: 100%;
      margin-bottom: 20px;
    }
    .invoice-header div {
      display: inline-block;
      width: 48%;
      vertical-align: top;
    }
    .invoice-header div h3 {
      margin: 0 0 5px 0;
      font-size: 16px;
      color: #2f3640;
    }
    .invoice-header div p {
      margin: 0;
      font-size: 14px;
      color: #636e72;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    th, td {
      border: 1px solid #dcdde1;
      padding: 10px;
      text-align: left;
      font-size: 14px;
    }
    th {
      background-color: #f1f2f6;
    }
    tr:nth-child(even) {
      background-color: #f9f9f9;
    }
    .total-row td {
      font-weight: bold;
      text-align: right;
    }
    .summary {
      margin-top: 20px;
      width: 100%;
      text-align: right;
      font-size: 14px;
    }
    .summary p {
      margin: 5px 0;
    }
    .bank-details {
      margin-top: 30px;
      padding: 15px;
      background-color: #f1f2f6;
      border-radius: 5px;
    }
    .bank-details h3 {
      margin-top: 0;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Invoice #{{invoiceData.invoiceNumber}}</h1>
    <p style="text-align:center; font-size:14px; color:#636e72;">Date: {{invoiceData.date}}</p>

    <div class="invoice-header">
      <div>
        <h3>Bill To:</h3>
        <p>{{invoiceData.lead.name}}</p>
        <p>{{invoiceData.lead.email}}</p>
      </div>
      <div>
        <h3>Dealer:</h3>
        <p>{{invoiceData.dealer.name}}</p>
        <p>{{invoiceData.dealer.email}}</p>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Product</th>
          <th>Details</th>
          <th>Unit Price</th>
          <th>Quantity</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        {{#each invoiceData.items}}
        <tr>
          <td>{{this.productName}}</td>
          <td>{{this.productDetails}}</td>
          <td>{{this.unitPrice}}</td>
          <td>{{this.quantity}}</td>
          <td>{{this.totalPrice}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="summary">
      <p>Subtotal: {{invoiceData.subTotal}}</p>
      <p>Tax: {{invoiceData.taxAmount}}</p>
      <p><strong>Grand Total: {{invoiceData.grandTotal}}</strong></p>
    </div>

    {{#if invoiceData.bank}}
    <div class="bank-details">
      <h3>Bank Details (Optional)</h3>
      <p>Account Holder: {{invoiceData.bank.accountHolderName}}</p>
      <p>Account Number: {{invoiceData.bank.accountNumber}}</p>
      <p>Bank Name: {{invoiceData.bank.bankName}}</p>
      <p>Branch Name: {{invoiceData.bank.branchName}}</p>
      <p>IFSC: {{invoiceData.bank.ifscCode}}</p>
      <p>IBAN: {{invoiceData.bank.iban}}</p>
      <p>SWIFT: {{invoiceData.bank.swiftCode}}</p>
    </div>
    {{/if}}
  </div>
</body>
</html>
