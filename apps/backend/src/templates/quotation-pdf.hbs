<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Quotation {{quotationData.quotationNumber}}</title>
  <style>
    @page {
      size: A4;
      margin: 10mm;
    }

    body {
      font-family: 'Arial', sans-serif;
      margin: 0;
      padding: 0;
      font-size: 11px;
      background-color: #f5f5f5;
    }

    .container {
      width: auto;
      background-color: #fff;
      border-radius: 8px;
      padding: 20px;
      box-sizing: border-box;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    td,
    th {
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    @media only screen and (max-width: 600px) {
      body {
        font-size: 10px;
      }

      .container {
        padding: 10px;
      }

      h1 {
        font-size: 18px !important;
      }

      h3 {
        font-size: 12px !important;
      }

      table td {
        padding: 2px 0 !important;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <table style="border:2px solid #ddd; border-radius:8px;">
      <tr>
        <td style="vertical-align:top; padding:16px;">

          <!-- Header -->
          <table style="width:100%; border-collapse:collapse; margin-bottom:20px;">
            <tr>
              <!-- Logo / Company -->
              <td style="vertical-align:top; width:48%; padding-right:8px;">
                {{#if quotationData.dealer.profile.logo}}
                <div style="width:80px; height:60px; overflow:hidden; margin-bottom:4px;">
                  <img src="{{quotationData.dealer.profile.logo}}" alt="Company Logo"
                    style="width:100%; height:100%; object-fit:contain;" />
                </div>
                {{else}}
                <div
                  style="width:80px; height:60px; display:flex; align-items:center; justify-content:center; font-size:10px; color:#999; background:#f0f0f0; margin-bottom:4px;">
                  Logo
                </div>
                {{/if}}
                <p style="margin:4px 0 0 0; font-size:14px; font-weight:600; color:#007b8f;">
                  {{#if quotationData.dealer.profile}}{{quotationData.dealer.profile.name}}{{else}}Company Name{{/if}}
                </p>
                <p style="margin:2px 0; font-size:12px; color:#666;">
                  {{#if quotationData.dealer.profile}}{{quotationData.dealer.profile.location}}{{else}}Plot 145, street 1,
                  London{{/if}}
                </p>
              </td>

              <!-- Quotation Info -->
              <td style="vertical-align:top; width:52%; text-align:right; padding-left:8px;">
                <h1 style="margin:0 0 6px 0; font-size:22px; font-weight:700; color:#007b8f;">QUOTATION</h1>
                <p style="margin:2px 0; font-size:12px; color:#333;">Quotation #: <strong>{{quotationData.quotationNumber}}</strong></p>
                <p style="margin:2px 0; font-size:12px; color:#333;">Quotation Date: {{quotationData.quotationDate}}</p>
                <p style="margin:2px 0; font-size:12px; color:#333;">Order Date: {{quotationData.orderDate}}</p>
              </td>
            </tr>
          </table>

          <!-- Vehicle Info -->
          <h3 style="margin:0 0 8px 0; font-size:14px; font-weight:600; color:#007b8f;">Vehicle Info</h3>
          <table style="margin-bottom:16px;">
            <tr>
              <td style="width:33%; font-size:13px; color:#555;">Reg No: {{#if
                quotationData.lead.vehicle_reg}}{{quotationData.lead.vehicle_reg}}{{else if
                quotationData.lead.vehicle_vrm}}{{quotationData.lead.vehicle_vrm}}{{else}}23A13{{/if}}</td>
              <td style="width:33%; font-size:13px; color:#555;">Make: {{#if
                quotationData.lead.vehicle_brand}}{{quotationData.lead.vehicle_brand}}{{else}}Audi{{/if}}</td>
              <td style="width:34%; font-size:13px; color:#555;">Model: {{#if
                quotationData.lead.vehicle_model}}{{quotationData.lead.vehicle_model}}{{else}}m3{{/if}}</td>
            </tr>
            <tr>
              <td style="font-size:13px; color:#555;">Reg Year: 2016</td>
              <td style="font-size:13px; color:#555;">Fuel Type: {{#if
                quotationData.lead.fuelType}}{{quotationData.lead.fuelType}}{{else}}Petrol{{/if}}</td>
              <td style="font-size:13px; color:#555;">Car Type: Engine</td>
            </tr>
          </table>

          <!-- Buyer + Recovery Section -->
          <table style="width:100%; margin-bottom:16px;">
            <tr>
              <td style="width:50%; vertical-align:top; padding-right:10px;">
                <h3 style="margin:0 0 8px 0; font-size:14px; font-weight:600; color:#007b8f;">Buyer Info</h3>
                <p style="margin:2px 0; font-size:13px; color:#555;">Name: {{quotationData.lead.name}}</p>
                <p style="margin:2px 0; font-size:13px; color:#555;">Phone: {{quotationData.lead.number}}</p>
                <p style="margin:2px 0; font-size:13px; color:#555;">Email: {{quotationData.lead.email}}</p>
                <p style="margin:2px 0; font-size:13px; color:#555;">Post: {{quotationData.lead.postcode}}</p>
              </td>

              <td style="width:50%; vertical-align:top;">
                <h3 style="margin:0 0 8px 0; font-size:14px; font-weight:600; color:#007b8f;">Recovery & Collection</h3>
                <p style="margin:2px 0; font-size:13px; color:#555;">Recovery Location:</p>
                <p style="margin:2px 0 6px 0; font-size:12px; color:#666; font-style:italic;">plot123, street 4, London
                </p>
                <p style="margin:2px 0; font-size:13px; color:#555;">Delivery Location:</p>
                <p style="margin:2px 0; font-size:12px; color:#666; font-style:italic;">plot123, street 4, London</p>
              </td>
            </tr>
          </table>

          <!-- Items Table -->
          <div style="overflow-x:auto; margin-bottom:16px;">
            <table style="width:100%; border:1px solid #ddd; border-radius:6px; font-size:12px;">
              <thead style="background-color:#007b8f; color:#fff;">
                <tr>
                  <th style="padding:6px; text-align:left;">Name</th>
                  <th style="padding:6px; text-align:right;">Rate</th>
                  <th style="padding:6px; text-align:right;">Qty</th>
                  <th style="padding:6px; text-align:right;">Total</th>
                </tr>
              </thead>
              <tbody>
                {{#each quotationData.items}}
                <tr style="border-bottom:1px solid #eee;">
                  <td style="padding:6px; color:#333;">{{this.productName}}</td>
                  <td style="padding:6px; text-align:right; color:#333;">${{this.unitPrice}}</td>
                  <td style="padding:6px; text-align:right; color:#333;">{{this.quantity}}</td>
                  <td style="padding:6px; text-align:right; color:#333;">${{this.subTotal}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>

          <!-- Totals -->
          <table style="margin-left:auto; width:250px; margin-bottom:16px;">
            <tr>
              <td style="padding:4px 6px; font-size:12px; color:#555;">Sub Total</td>
              <td style="padding:4px 6px; text-align:right; font-size:12px; color:#555;">${{quotationData.subTotal}}</td>
            </tr>
            <tr>
              <td style="padding:4px 6px; font-size:12px; color:#555;">VAT ({{quotationData.taxPercentage}}%)</td>
              <td style="padding:4px 6px; text-align:right; font-size:12px; color:#555;">${{quotationData.totalTax}}</td>
            </tr>
            <tr>
              <td style="padding:4px 6px; font-size:12px; color:#555;">Discount ({{quotationData.discountPercentage}}%)</td>
              <td style="padding:4px 6px; text-align:right; font-size:12px; color:#555;">${{quotationData.totalDiscount}}</td>
            </tr>
            <tr style="border-top:2px solid #007b8f;">
              <td style="padding:6px; font-size:13px; font-weight:700; color:#007b8f;">Total</td>
              <td style="padding:6px; text-align:right; font-size:13px; font-weight:700; color:#007b8f;">
                ${{quotationData.grandTotal}}</td>
            </tr>
          </table>

          <!-- Bank Details -->
          <h3 style="margin:0 0 6px 0; font-size:13px; font-weight:600; color:#007b8f;">Bank Details</h3>
          <div style="border:1px solid #ddd; border-radius:6px; padding:8px; margin-bottom:12px;">
            {{#if quotationData.bank}}
            <table style="width:100%;">
              <tr>
                <td style="width:50%; font-size:11px; color:#555;">Account Holder: {{quotationData.bank.accountHolderName}}</td>
                <td style="width:50%; font-size:11px; color:#555;">IFSC: {{quotationData.bank.ifscCode}}</td>
              </tr>
              <tr>
                <td style="font-size:11px; color:#555;">Account Number: {{quotationData.bank.accountNumber}}</td>
                <td style="font-size:11px; color:#555;">IBAN: {{quotationData.bank.iban}}</td>
              </tr>
              <tr>
                <td style="font-size:11px; color:#555;">Bank Name: {{quotationData.bank.bankName}}</td>
                <td style="font-size:11px; color:#555;">SWIFT: {{quotationData.bank.swiftCode}}</td>
              </tr>
              <tr>
                <td colspan="2" style="font-size:11px; color:#555;">Branch Name: {{quotationData.bank.branchName}}</td>
              </tr>
            </table>
            {{else}}
            <p style="margin:0; font-size:11px; color:#999;">No bank details configured</p>
            {{/if}}
          </div>

          <!-- Seller Note -->
          <h3 style="margin:0 0 4px 0; font-size:13px; font-weight:600; color:#007b8f;">Seller Note</h3>
          <p style="margin:0 0 12px 0; font-size:11px; color:#555;">{{quotationData.sellerNote}}</p>

          <!-- Quotation Terms -->
          <h3 style="margin:0 0 4px 0; font-size:13px; font-weight:600; color:#007b8f;">Quotation Terms</h3>
          <p style="margin:0 0 12px 0; font-size:10px; color:#666;">{{quotationData.quotationTerms}}</p>

          <!-- Sales Terms -->
          <h3 style="margin:0 0 4px 0; font-size:13px; font-weight:600; color:#007b8f;">Sales Terms</h3>
          <p style="margin:0; font-size:10px; color:#666;">{{quotationData.salesTerms}}</p>

        </td>
      </tr>
    </table>

    <!-- Footer -->
    <div style="margin-top:20px; text-align:center; border-top:2px solid #007b8f; padding-top:10px;">
      <p style="margin:0; color:#007b8f; font-weight:bold; font-size:13px;">Thank You For Your Business!</p>
    </div>
  </div>
</body>

</html>
